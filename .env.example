# Copy to .env; replace placeholders before Docker Compose startup.
POSTGRES_USER=flakeguard
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=flakeguard
DATABASE_URL=postgresql+psycopg://flakeguard:replace-with-a-local-password@localhost:5432/flakeguard
# Optional API shared secret. Required for all /api requests when set; dashboard sends it server-side.
FLAKEGUARD_API_KEY=
FLAKEGUARD_API_URL=http://127.0.0.1:8000
# For an anonymous public demo, use a separate seeded database and set this on API and dashboard.
FLAKEGUARD_READ_ONLY=false
# Optional fine-grained token: Actions read on only the repositories configured below.
GITHUB_TOKEN=
GITHUB_REPOSITORIES=
MAX_REPORT_BYTES=20971520
MAX_ARCHIVE_BYTES=52428800
MAX_ARCHIVE_FILES=200
MAX_RESULTS=100000
HTTP_TIMEOUT_SECONDS=30
